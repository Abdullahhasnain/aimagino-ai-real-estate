# Optional public webhook for receiving website enquiries (for example a Google Apps Script endpoint).
# The endpoint receives JSON: { lead, message }.
VITE_LEAD_WEBHOOK_URL=
VITE_LEAD_API_URL=/api/lead

# Optional Supabase Free project. When all three are set, public enquiries are
# stored centrally and the dashboard requires an authenticated agency user.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_WORKSPACE_SLUG=your-agency-slug

# Server-only Vercel environment variables. Never prefix these with VITE_ and
# never put their real values in a committed .env file.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
WORKSPACE_SLUG=your-agency-slug
HUBSPOT_PRIVATE_APP_TOKEN=
RESEND_API_KEY=
LEAD_NOTIFICATION_EMAIL=
LEAD_FROM_EMAIL=
ALLOWED_ORIGIN=
